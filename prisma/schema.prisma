generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String               @id @default(uuid())
  name        String
  email       String               @unique
  image       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  clerkUserId String               @unique
  memberships BusinessMembership[]
}

model MenuItem {
  id              String      @id @default(uuid())
  restaurantId    String
  name            String
  description     String?
  price           Float
  preparationTime Int
  image           String?
  isAvailable     Boolean     @default(true)
  isVeg           Boolean
  spiceLevel      SpiceLevel
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  category        String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([category])
}

model Business {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  logo        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships BusinessMembership[]
  restaurants Restaurant[]
}

model BusinessMembership {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Restaurant {
  id               String          @id @default(uuid())
  businessId       String
  name             String
  slug             String
  description      String?
  phone            String?
  email            String?
  address          String?
  propertyType     PropertyType
  timezone         String
  currency         String
  parkingAvailable Boolean
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  diningSessions   DiningSession[]
  floors           Floor[]
  menuItems        MenuItem[]
  orders           Order[]
  reservations     Reservation[]
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
}

model Floor {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  level        Int
  width        Float
  height       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       Table[]

  @@unique([restaurantId, level])
  @@index([restaurantId])
}

model Table {
  id             String          @id @default(uuid())
  floorId        String
  number         String
  capacity       Int
  shape          TableShape
  status         TableStatus     @default(AVAILABLE)
  xPosition      Float
  yPosition      Float
  rotation       Float           @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  diningSessions DiningSession[]
  orders         Order[]
  reservations   Reservation[]
  floor          Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([floorId, number])
  @@index([floorId])
}

model Guest {
  id             String          @id @default(uuid())
  name           String
  phone          String          @unique
  email          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  diningSessions DiningSession[]
  reservations   Reservation[]
}

model Order {
  id           String      @id @default(uuid())
  restaurantId String
  tableId      String
  status       OrderStatus @default(PENDING)
  totalAmount  Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Reservation {
  id                String            @id @default(cuid())
  restaurantId      String
  tableId           String
  guestId           String
  reservationTime   DateTime
  partySize         Int
  occasion          String?
  seatingPreference String?
  noisePreference   String?
  status            ReservationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  diningSessions    DiningSession?
  guest             Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, reservationTime])
  @@index([restaurantId])
  @@index([tableId])
  @@index([guestId])
  @@index([restaurantId, reservationTime])
}

model DiningSession {
  id            String              @id @default(uuid())
  restaurantId  String
  tableId       String
  reservationId String?             @unique
  guestId       String
  startedAt     DateTime
  endedAt       DateTime?
  status        DiningSessionStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  guest         Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservation   Reservation?        @relation(fields: [reservationId], references: [id])
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableId])
  @@index([reservationId])
  @@index([guestId])
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  VERY_HOT
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  KITCHEN
}

enum PropertyType {
  OWNED
  LEASED
  RENTED
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  SOFA
  BAR
  OUTDOOR
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DiningSessionStatus {
  ACTIVE
  CLOSED
}
